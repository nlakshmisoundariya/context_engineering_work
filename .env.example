# NovaAssist configuration. Copy to .env (never commit .env).
# On the hosted servers the platform injects LLM_API_KEY into your session; you do not need to set it.

# --- LLM (one provider behind novaassist/llm_client.py) ---
LLM_PROVIDER=openai            # openai | fake (fake = offline deterministic client for tests and dry runs)
LLM_MODEL=gpt-6-luna           # do not change unless the trainer says so
LLM_API_KEY=                   # falls back to OPENAI_API_KEY if empty
LLM_MAX_COMPLETION_TOKENS=4096 # reasoning model: hidden reasoning uses this budget too

# --- Local models (already in the shared read-only cache on the servers) ---
HF_HOME=                       # shared Hugging Face cache (set by the platform)
HF_HUB_OFFLINE=1               # never download at runtime
MODEL_CACHE_DIR=               # optional: explicit cache folder; overrides HF_HOME's default hub cache
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Token counting for the simulated 12K budget ---
CE_TOKEN_COUNTER=auto          # auto | tiktoken | approx

# --- Shared Neo4j (needed from S11; read-only) ---
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# --- OCR (optional override; default: tesseract on PATH) ---
TESSERACT_CMD=
